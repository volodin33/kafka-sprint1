{
  "Kafka": {
    "BootstrapServers": "127.0.0.1:9094,127.0.0.1:9095,127.0.0.1:9096"
  },
  "Producers": [
    {
      "Name": "producer-1",
      "Topic": "orders",
      "Enabled": true,
      "SendIntervalMs": 1000,
      "Acks": "all",
      "MessageSendMaxRetries": 3,
      "EnableIdempotence": false,
      "SerializationFormat": "Json"
    }
  ],
  "Consumers": [
    {
      "Name": "consumer-1",
      "Topic": "orders",
      "GroupId": "orders-group",
      "Enabled": true,
      "AutoOffsetReset": "Earliest",
      "CommitMode": "Auto",
      "ReadMode": "Single",
      "SerializationFormat": "Json"
    },
    {
      "Name": "consumer-2",
      "Topic": "orders",
      "GroupId": "analytics-group",
      "Enabled": true,
      "AutoOffsetReset": "Earliest",
      "CommitMode": "Manual",
      "ReadMode": "Batch",
      "BatchSize": 10,
      "BatchTimeoutMs": 30000,
      "SerializationFormat": "Json",
      "FetchMinBytes": 1,
      "FetchMaxBytes": 52428800,
      "FetchWaitMaxMs": 500
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
